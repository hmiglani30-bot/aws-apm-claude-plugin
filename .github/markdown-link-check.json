{
  "ignorePatterns": [
    { "pattern": "^<deep-link>$" },
    { "pattern": "^<.*>$" },
    { "pattern": "^http://localhost" },
    { "pattern": "^#" }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://docs.aws.amazon.com"],
      "headers": { "Accept-Encoding": "zstd, br, gzip, deflate" }
    }
  ],
  "timeout": "20s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 403, 429]
}
